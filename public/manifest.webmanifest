{
  "id": "/",
  "name": "WESTERN UG CONNECT",
  "short_name": "WUG Connect",
  "description": "Dating for singles in Western Uganda and across Uganda.",
  "start_url": "/?source=app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#ffffff",
  "theme_color": "#3b0764",
