# Copy this file to .env.local for local development.
# These two values are SAFE to expose in the browser — data is protected by
# Row Level Security. NEVER put the service_role key in this file or in Netlify.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Public site address (used for email links and SEO), no trailing slash
VITE_SITE_URL=http://localhost:5173

# Shown on the Contact page
VITE_SUPPORT_EMAIL=support@example.com
